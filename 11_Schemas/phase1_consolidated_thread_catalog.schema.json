{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase1_consolidated_thread_catalog.schema.json",
  "title": "Trump Diary Phase 1 Consolidated Thread Catalog",
  "description": "Year-wide canonical thread catalog consolidated from overlapping Phase 1 window candidate outputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "package_type",
    "scope",
    "build",
    "source_windows",
    "canonical_threads",
    "rejected_or_folded_candidates",
    "consolidation_notes"
  ],
  "properties": {
    "schema_name": {
      "type": "string",
      "const": "phase1_consolidated_thread_catalog"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "package_type": {
      "type": "string",
      "const": "thread_catalog_consolidation"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "period_label",
        "start_week",
        "end_week",
        "window_count",
        "window_ids"
      ],
      "properties": {
        "project": {
          "type": "string"
        },
        "period_label": {
          "type": "string"
        },
        "start_week": {
          "type": "integer",
          "minimum": 1
        },
        "end_week": {
          "type": "integer",
          "minimum": 1
        },
        "window_count": {
          "type": "integer",
          "minimum": 1
        },
        "window_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^window_[0-9]{3}$"
          }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "created_by",
        "model",
        "run_id",
        "prompt_version"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        },
        "git_commit": {
          "type": ["string", "null"]
        }
      }
    },
    "source_windows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_window"
      }
    },
    "canonical_threads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/canonical_thread"
      }
    },
    "rejected_or_folded_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rejected_or_folded_candidate"
      }
    },
    "consolidation_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "source_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_id",
        "start_week",
        "end_week",
        "candidate_file",
        "candidate_count"
      ],
      "properties": {
        "window_id": {
          "type": "string",
          "pattern": "^window_[0-9]{3}$"
        },
        "start_week": {
          "type": "integer",
          "minimum": 1
        },
        "end_week": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_file": {
          "type": "string"
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "canonical_thread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thread_id",
        "canonical_name",
        "short_name",
        "description",
        "scope_level",
        "window_ids",
        "supporting_weeks",
        "source_candidate_ids",
        "source_candidate_names",
        "aliases",
        "inclusion_notes",
        "exclusion_notes",
        "boundary_notes",
        "parent_thread_id",
        "child_thread_ids",
        "related_thread_ids",
        "continuity_summary",
        "merge_rationale",
        "democracy_clock_categories",
        "democracy_clock_traits"
      ],
      "properties": {
        "thread_id": {
          "type": "string",
          "pattern": "^THR_[A-Z0-9_]{3,100}$"
        },
        "canonical_name": {
          "type": "string",
          "minLength": 3
        },
        "short_name": {
          "type": "string",
          "minLength": 3
        },
        "description": {
          "type": "string",
          "minLength": 10
        },
        "scope_level": {
          "type": "string",
          "enum": ["super_thread", "thread", "sub_thread"]
        },
        "window_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^window_[0-9]{3}$"
          }
        },
        "supporting_weeks": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "source_candidate_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^cand_[A-Z0-9_]{3,100}$"
          }
        },
        "source_candidate_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inclusion_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclusion_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "boundary_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parent_thread_id": {
          "type": ["string", "null"],
          "pattern": "^THR_[A-Z0-9_]{3,100}$"
        },
        "child_thread_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^THR_[A-Z0-9_]{3,100}$"
          }
        },
        "related_thread_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^THR_[A-Z0-9_]{3,100}$"
          }
        },
        "continuity_summary": {
          "type": "string"
        },
        "merge_rationale": {
          "type": "string"
        },
        "democracy_clock_categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "democracy_clock_traits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rejected_or_folded_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_window_id",
        "source_candidate_id",
        "source_candidate_name",
        "disposition",
        "reason",
        "folded_into_thread_id"
      ],
      "properties": {
        "source_window_id": {
          "type": "string",
          "pattern": "^window_[0-9]{3}$"
        },
        "source_candidate_id": {
          "type": ["string", "null"],
          "pattern": "^cand_[A-Z0-9_]{3,100}$"
        },
        "source_candidate_name": {
          "type": "string"
        },
        "disposition": {
          "type": "string",
          "enum": ["folded", "rejected"]
        },
        "reason": {
          "type": "string"
        },
        "folded_into_thread_id": {
          "type": ["string", "null"],
          "pattern": "^THR_[A-Z0-9_]{3,100}$"
        }
      }
    }
  }
}