{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase2_timeline_output.schema.json",
  "title": "Trump Chronicles Timeline By Week Output",
  "description": "Schema for the back-matter Timeline by Week appendix output for Trump Chronicles.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "section",
    "book_title",
    "build",
    "generated_from",
    "entries"
  ],
  "properties": {
    "schema_name": {
      "type": "string",
      "const": "phase2_timeline_output"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "section": {
      "type": "string",
      "const": "timeline_by_week"
    },
    "book_title": {
      "type": "string",
      "const": "Trump Chronicles"
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "created_by",
        "model",
        "run_id",
        "prompt_version",
        "git_commit"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "type": "string"
        },
        "model": {
          "type": ["string", "null"]
        },
        "run_id": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        },
        "git_commit": {
          "type": ["string", "null"]
        }
      }
    },
    "generated_from": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata_stack_pattern",
        "weekly_spine_pattern"
      ],
      "properties": {
        "metadata_stack_pattern": {
          "type": "string"
        },
        "weekly_spine_pattern": {
          "type": "string"
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "description": "Timeline entries in ascending week order.",
      "items": {
        "$ref": "#/$defs/timeline_entry"
      }
    }
  },
  "$defs": {
    "timeline_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "week",
        "start_date",
        "end_date",
        "date_display",
        "chapter_title",
        "gloss",
        "source_priority_used",
        "source_metadata_stack",
        "source_weekly_spine"
      ],
      "properties": {
        "week": {
          "type": "integer",
          "minimum": 1
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "format": "date"
        },
        "date_display": {
          "type": "string",
          "minLength": 1
        },
        "chapter_title": {
          "type": "string",
          "minLength": 1
        },
        "gloss": {
          "type": "string",
          "minLength": 1,
          "description": "Reader-facing appendix gloss for the week’s main democratic significance; in the first pass this may be the metadata week_summary used verbatim."
        },
        "source_priority_used": {
          "type": "string",
          "enum": [
            "metadata.week_summary",
            "metadata.short_synopsis",
            "spine.week_summary",
            "metadata.long_synopsis",
            "whole_week_arcs"
          ]
        },
        "source_metadata_stack": {
          "type": "string",
          "minLength": 1
        },
        "source_weekly_spine": {
          "type": ["string", "null"]
        }
      }
    }
  }
}