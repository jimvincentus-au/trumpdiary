{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase2_year_themes_chapter.schema.json",
  "title": "Trump Chronicles Year Themes Chapter Package",
  "description": "Schema for the end-of-year synthesis chapter package covering the twelve key themes of the year in Trump Chronicles.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "package_type",
    "book_title",
    "chapter_title",
    "build",
    "generated_from",
    "chapter_brief",
    "themes",
    "closing_brief"
  ],
  "properties": {
    "schema_name": {
      "type": "string",
      "const": "phase2_year_themes_chapter"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "package_type": {
      "type": "string",
      "const": "year_themes_chapter_package"
    },
    "book_title": {
      "type": "string",
      "const": "Trump Chronicles"
    },
    "chapter_title": {
      "type": "string",
      "minLength": 1
    },
    "chapter_subtitle": {
      "type": [
        "string",
        "null"
      ]
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "created_by",
        "model",
        "run_id",
        "prompt_version",
        "git_commit"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "type": "string"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_version": {
          "type": "string"
        },
        "git_commit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "generated_from": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeline_by_week_file",
        "key_themes_file",
        "source_week_range"
      ],
      "properties": {
        "timeline_by_week_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "key_themes_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_week_range": {
          "$ref": "#/$defs/week_range"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "chapter_brief": {
      "$ref": "#/$defs/chapter_brief"
    },
    "themes": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "description": "The twelve major themes of the year, in final chapter order.",
      "items": {
        "$ref": "#/$defs/theme_section"
      }
    },
    "closing_brief": {
      "$ref": "#/$defs/closing_brief"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "week_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_week",
        "end_week"
      ],
      "properties": {
        "start_week": {
          "type": "integer",
          "minimum": 1
        },
        "end_week": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "chapter_brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "placement",
        "opening_brief",
        "opening_targets",
        "tone_notes",
        "word_count_target"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "placement": {
          "type": "string",
          "minLength": 1
        },
        "opening_brief": {
          "type": "string",
          "minLength": 1
        },
        "opening_targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "tone_notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "word_count_target": {
          "$ref": "#/$defs/word_count_target"
        }
      }
    },
    "theme_section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme_id",
        "theme_name",
        "sort_order",
        "section_role",
        "framing_line",
        "section_brief",
        "recurring_forms",
        "illustrative_weeks",
        "bridge_forward"
      ],
      "properties": {
        "theme_id": {
          "type": "string",
          "pattern": "^THEME_[A-Z0-9_]{3,100}$"
        },
        "theme_name": {
          "type": "string",
          "minLength": 1
        },
        "sort_order": {
          "type": "integer",
          "minimum": 1
        },
        "section_role": {
          "type": "string",
          "minLength": 1,
          "description": "What this subsection does in the chapter argument."
        },
        "framing_line": {
          "type": "string",
          "minLength": 1
        },
        "section_brief": {
          "type": "string",
          "minLength": 1,
          "description": "Narrative brief for the subsection."
        },
        "recurring_forms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/recurring_form"
          }
        },
        "illustrative_weeks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/illustrative_week"
          }
        },
        "bridge_forward": {
          "type": "string",
          "minLength": 1,
          "description": "Transition logic into the next subsection."
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "recurring_form": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "form_id",
        "form_name",
        "form_description"
      ],
      "properties": {
        "form_id": {
          "type": "string",
          "pattern": "^FORM_[A-Z0-9_]{3,100}$"
        },
        "form_name": {
          "type": "string",
          "minLength": 1
        },
        "form_description": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "illustrative_week": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "week",
        "why_it_matters"
      ],
      "properties": {
        "week": {
          "type": "integer",
          "minimum": 1
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "closing_brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "closing_brief",
        "closing_targets"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "closing_brief": {
          "type": "string",
          "minLength": 1
        },
        "closing_targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "word_count_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opening_min",
        "opening_max",
        "section_min",
        "section_max",
        "closing_min",
        "closing_max",
        "chapter_min",
        "chapter_max"
      ],
      "properties": {
        "opening_min": {
          "type": "integer",
          "minimum": 1
        },
        "opening_max": {
          "type": "integer",
          "minimum": 1
        },
        "section_min": {
          "type": "integer",
          "minimum": 1
        },
        "section_max": {
          "type": "integer",
          "minimum": 1
        },
        "closing_min": {
          "type": "integer",
          "minimum": 1
        },
        "closing_max": {
          "type": "integer",
          "minimum": 1
        },
        "chapter_min": {
          "type": "integer",
          "minimum": 1
        },
        "chapter_max": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}